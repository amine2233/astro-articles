---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { useTranslations, url, langs, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Path of this page in every available language, for hreflang + switcher. */
  alternates?: Partial<Record<Lang, string>>;
}

const { lang, title, description, alternates = {} } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} · ${t('site.title')}` : t('site.title');
const desc = description ?? t('site.tagline');
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={t('site.title')} href={url(`/${lang}/rss.xml`)} />
    {langs.map((l) => alternates[l] && (
      <link rel="alternate" hreflang={l} href={new URL(url(alternates[l]!), Astro.site)} />
    ))}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <!-- Apply saved theme before paint to avoid a flash -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <Header lang={lang} alternates={alternates} />
    <main class="container">
      <slot />
    </main>
    <footer class="container footer">
      <span>© {new Date().getFullYear()} · {t('site.title')}</span>
      <a href={url(`/${lang}/rss.xml`)}>{t('nav.rss')}</a>
    </footer>
  </body>
</html>
