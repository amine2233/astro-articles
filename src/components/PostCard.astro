---
import type { CollectionEntry } from 'astro:content';
import { formatDate, splitId, url, useTranslations, readingTime, type Lang } from '../i18n/ui';

interface Props { post: CollectionEntry<'blog'>; lang: Lang }
const { post, lang } = Astro.props;
const { slug } = splitId(post.id);
const t = useTranslations(lang);
---
<article class="card">
  <a class="card-link" href={url(`/${lang}/blog/${slug}/`)}>
    <h2>{post.data.title}{post.data.draft && <span class="badge">draft</span>}</h2>
  </a>
  <p class="meta">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>{' · '}{t('post.readingTime', { n: readingTime(post.body) })}
  </p>
  <p>{post.data.description}</p>
  <ul class="tags">
    {post.data.tags.map((tag) => <li><a href={url(`/${lang}/tags/${tag}/`)}>#{tag}</a></li>)}
  </ul>
</article>
