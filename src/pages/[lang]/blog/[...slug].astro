---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import {
  langs, getPosts, getTranslations, splitId, formatDate, readingTime,
  useTranslations, url, type Lang,
} from '../../../i18n/ui';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of langs) {
    for (const post of await getPosts(lang)) {
      paths.push({ params: { lang, slug: splitId(post.id).slug }, props: { post } });
    }
  }
  return paths;
}

const { post } = Astro.props;
const lang = Astro.params.lang as Lang;
const { slug } = splitId(post.id);
const t = useTranslations(lang);
const { Content } = await render(post);

// Link each language version of this article together.
const available = await getTranslations(post);
const alternates = Object.fromEntries(available.map((l) => [l, `/${l}/blog/${slug}/`]));
const other = available.find((l) => l !== lang);
---
<Base lang={lang} title={post.data.title} description={post.data.description} alternates={alternates}>
  <article>
    <header class="post-header">
      <a href={url(`/${lang}/`)} class="meta">{t('post.back')}</a>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>{' · '}{t('post.readingTime', { n: readingTime(post.body) })}
        {post.data.updated && <>{' · '}{t('post.updated')} {formatDate(post.data.updated, lang)}</>}
      </p>
      <ul class="tags">
        {post.data.tags.map((tag) => <li><a href={url(`/${lang}/tags/${tag}/`)}>#{tag}</a></li>)}
      </ul>
      {other && (
        <a class="translation-link" href={url(`/${other}/blog/${slug}/`)} hreflang={other}>
          🌐 {t('post.translation')}
        </a>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
