---
import Base from '../../../layouts/Base.astro';
import { getPosts, langs, useTranslations, url, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const posts = await getPosts(lang);
const counts = new Map<string, number>();
for (const p of posts) for (const tag of p.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<Base lang={lang} title={t('nav.tags')} alternates={{ en: '/en/tags/', fr: '/fr/tags/' }}>
  <section class="hero"><h1>{t('nav.tags')}</h1></section>
  <ul class="tags">
    {tags.map(([tag, n]) => <li><a href={url(`/${lang}/tags/${tag}/`)}>#{tag} ({n})</a></li>)}
  </ul>
</Base>
